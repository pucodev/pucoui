{
  "name": "pucoui",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/pucodev/pucoui#readme",
  "bugs": {
    "url": "https://github.com/pucodev/pucoui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pucodev/pucoui.git"
  },
  "license": "MIT",
  "author": "",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run plugins:dev:components && npm run plugins:dev:showcases && npm run dev:concurrently",
    "dev:concurrently": "concurrently -k -n Styles,Plugins:Components,Plugins:Showcases,Docs -p [{name}] --prefix-colors blue 'npm:pucoui:dev' 'npm:plugins:dev:components:watch' 'npm:plugins:dev:showcases:watch' 'npm:docs:dev'",
    "docs:deploy": "npm run deploy --workspace=@pucoui/docs",
    "docs:dev": "npm run start --workspace=@pucoui/docs",
    "plugins:dev": "npm run start --workspace=@pucoui/plugins",
    "plugins:dev:components": "npm run dev:components --workspace=@pucoui/plugins",
    "plugins:dev:components:watch": "npm run dev:components:watch --workspace=@pucoui/plugins",
    "plugins:dev:showcases": "npm run dev:showcases --workspace=@pucoui/plugins",
    "plugins:dev:showcases:watch": "npm run dev:showcases:watch --workspace=@pucoui/plugins",
    "prepare": "husky",
    "publish": "npm publish --workspace=pucoui",
    "pucoui:build": "npm run build --workspace=pucoui",
    "pucoui:dev": "npm run dev --workspace=pucoui",
    "snippets:build": "npm run build --workspace=@pucoui/snippets"
  },
  "lint-staged": {
    "*.{js,ts,json,css,md,scss}": "prettier --write"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-packagejson": "^2.5.19"
  }
}
