{
  "name": "@pucoui/plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:components": "tsx convertComponents.js",
    "dev:components:watch": "npm run dev:components -- --watch-only",
    "dev:showcases": "tsx convertShowcases.js",
    "dev:showcases:watch": "npm run dev:showcases -- --watch-only",
    "start": "npm run dev:p && npm run dev:showcases && concurrently -k -n Plugins:Components,Plugins:Showcases -p [{name}] --prefix-colors blue 'npm:dev:p -- --watch-only' 'npm:dev:showcases -- --watch-only'"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.3",
    "yargs": "^18.0.0"
  },
  "devDependencies": {}
}
